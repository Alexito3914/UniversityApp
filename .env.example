# Copia a .env y ajusta valores para el servidor de la universidad
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=horarios.ucjc.es,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://horarios.ucjc.es
DJANGO_SECURE_COOKIES=True

# Base de datos (recomendado en producción)
DB_ENGINE=postgresql
DB_NAME=ucjc_horarios
DB_USER=ucjc
DB_PASSWORD=cambiar
DB_HOST=127.0.0.1
DB_PORT=5432

# Sesión (segundos)
SESSION_COOKIE_AGE=3600
